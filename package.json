{
	"name": "scraping-documentacion-regulatoria",
	"version": "1.0.0",
	"description": "Aplicación de scraping diseñada para extraer documentación oficial de webs reguladoras de instituciones. Utiliza Puppeteer para la extracción de datos y Nodemailer para enviar los informes por correo electrónico.",
	"main": "src/index.ts",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"typecheck:watch": "tsc --noEmit --watch",
		"format": "prettier --write \".\"",
		"format:check": "prettier --check \".\"",
		"dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0  bun --env-file=.env.dev --watch run src/index.ts",
		"build": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 bun --env-file=.env.prod run tsc",
		"start": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 bun --env-file=.env.prod run dist/index.js",
		"test": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 bun --env-file=.env.test run src/test.ts"
	},
	"keywords": [
		"scraping",
		"puppeteer",
		"nodejs",
		"web-scraping",
		"regulatorio",
		"documentacion"
	],
	"author": "Amyssyko",
	"license": "MIT",
	"type": "module",
	"dependencies": {
		"@js-temporal/polyfill": "0.5.1",
		"nodemailer": "10.0.0",
		"puppeteer": "25.10.0",
		"zod": "4.5.4"
	},
	"devDependencies": {
		"@types/bun": "1.4.1",
		"@types/nodemailer": "8.0.1",
		"cross-env": "10.1.0",
		"tsx": "4.23.13",
		"prettier": "3.9.6",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.4.1"
}
